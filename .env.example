# Merge needed variables into .env.local; keep existing local credentials.
AI_GATEWAY_API_KEY=
EVIDENCE_SANDBOX_SNAPSHOT_ID=
# New cases default to shared instruction (2). Set 1 only to roll back new cases.
# COURT_PIPELINE_VERSION=2
# Optional bridge overrides: defaults to APP_BASE_URL (or VERCEL_URL), the host's
# Vercel OIDC team/project identity (from the function context, or a local
# VERCEL_OIDC_TOKEN), and EVIDENCE_SANDBOX_SNAPSHOT_ID.
# INSTRUCTION_TOOL_ORIGIN=https://your-app.example
# INSTRUCTION_SANDBOX_TEAM_ID=
# INSTRUCTION_SANDBOX_PROJECT_ID=
# INSTRUCTION_SANDBOX_SNAPSHOT_ID=
# Cloudflare R2 bucket for evidence. Writes use an R2 API token (Object Read & Write on the bucket);
# objects are publicly readable at R2_PUBLIC_URL, the bucket's custom domain.
R2_ACCOUNT_ID=c128552e62fce08f84bdf6de0ba9edf5
R2_BUCKET=chebot
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=https://blob.che.bot
# Only for npm run evidence:migrate-r2, which copies the former Vercel Blob store to R2.
# BLOB_READ_WRITE_TOKEN=
# Optional: Browserbase stealth browser fallback when direct impit fetch hits JS shells or bot blocks.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# Optional: auto (default, tries managed residential proxies first), true, or false.
# BROWSERBASE_PROXIES=auto
# Use mock for fictitious AI responses and research without provider credentials.
COURT_AI_MODE=live
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/grokeado
APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
# Optional: defaults to 270000 ms per seat attempt.
COURT_TURN_TIMEOUT_MS=270000
# Optional: workflow function duration in seconds, set at build time (default 600).
# STEP_TIMEOUT=600
# Optional: if the local Next server uses a different port.
# WORKFLOW_LOCAL_BASE_URL=http://localhost:3001
