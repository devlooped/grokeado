# Merge needed variables into .env.local; keep existing local credentials.
AI_GATEWAY_API_KEY=
# Use mock for fictitious AI responses and research without provider credentials.
COURT_AI_MODE=live
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/grokeado
APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
# Optional: defaults to 270000 ms per seat attempt.
COURT_TURN_TIMEOUT_MS=270000
# Optional: if the local Next server uses a different port.
# WORKFLOW_LOCAL_BASE_URL=http://localhost:3001
