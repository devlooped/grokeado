# Merge needed variables into .env.local; keep existing local credentials.
AI_GATEWAY_API_KEY=
# Dedicated, budget-limited AI Gateway key used only by the evidence sandbox.
EVIDENCE_AI_GATEWAY_API_KEY=
EVIDENCE_SANDBOX_SNAPSHOT_ID=
# Token for a public-read Vercel Blob store. Deployed writes use the token; blob URLs are readable without it.
BLOB_READ_WRITE_TOKEN=
# Local smoke uses OIDC instead of the read-write token. The smoke script mints VERCEL_OIDC_TOKEN.
# The store's project connection must include Development.
BLOB_STORE_ID=
# Optional: Browserbase stealth browser fallback when direct impit fetch hits JS shells or bot blocks.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# Optional: auto (default, tries managed residential proxies first), true, or false.
# BROWSERBASE_PROXIES=auto
# Use mock for fictitious AI responses and research without provider credentials.
COURT_AI_MODE=live
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/grokeado
APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
# Optional: defaults to 270000 ms per seat attempt.
COURT_TURN_TIMEOUT_MS=270000
# Optional: if the local Next server uses a different port.
# WORKFLOW_LOCAL_BASE_URL=http://localhost:3001
